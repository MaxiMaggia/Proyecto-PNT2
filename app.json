{
  "expo": {
    "name": "vet-finder",
    "slug": "vet-finder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/paw.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/paw.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [],
    "extra": {
      "apiUrl": "http://192.168.0.15:3000"
    },
    "ios": { "supportsTablet": true },
    "infoPlist": {
      "NSAppTransportSecurity": {
        "NSAllowsArbitraryLoads": true
      },
      "NSLocationWhenInUseUsageDescription": "Esta aplicación necesita acceder a tu ubicación para mostrarte las veterinarias más cercanas.",
      "NSLocationAlwaysAndWhenInUseUsageDescription": "Esta aplicación necesita acceder a tu ubicación para mostrarte las veterinarias más cercanas."
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/paw.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "softwareKeyboardLayoutMode": "pan",
    "web": { "favicon": "./assets/paw.png" }
  }
}
